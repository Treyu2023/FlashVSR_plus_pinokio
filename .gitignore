# Runtime / bulk (never commit)
app/env/
app/models/
app/outputs/
app/_temp/
app/inputs/
app/**/__pycache__/
app/**/*.pyc
app/**/.cache/
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Local user config (machine-specific paths), rewritten at runtime. Untracked with
# git rm --cached; the app falls back to built-in defaults when they are missing.
app/webui_config
app/job_profiles.json

# Local recovery snapshots (machine-specific; also mirrored under C:\pinokio\backups\)
local-preserve/

# Logs / caches at repo root
cache/
logs/

# Dated local backups of app/webui_config (machine-local; never commit). The tracked app/webui_config.bak is not matched.
app/webui_config.bak-*
